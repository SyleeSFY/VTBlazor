@using Client.Core.Entities.Enums
@inject IJSRuntime JS

<div class="chat-container mb-5" style="border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
    <h4 style="margin-bottom: 20px;">Чат по решению</h4>
    
    <!-- Блок ошибок -->
    @if (!string.IsNullOrEmpty(_errorMessage)) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-bottom: 15px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Ошибка!</strong> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }
    
    <div class="messages-container"
         @ref="_messagesContainer"
         style="height: 400px; scroll-behavior: smooth; overflow-y: auto; margin-bottom: 20px; padding: 10px; background: #f9f9f9; border-radius: 4px;">
        @if (Messages == null || !Messages.Any()) {
            <p style="color: #666; text-align: center; margin-top: 180px;">Нет сообщений</p>
        }
        else {
            @foreach (var message in Messages.OrderBy(m => m.SentAt)) {
                var isCurrentUser = message.SenderId == User.Id;
                
                <div class="message @(isCurrentUser ? "my-message" : "other-message")"
                     style="margin-bottom: 15px; display: flex; @(isCurrentUser ? "justify-content: flex-end;" : "justify-content: flex-start;")">
                    <div style="max-width: 70%;">
                        <div style="padding: 10px; border-radius: 10px;
                            @(isCurrentUser ? "background: #006928d8; color: white;" : "background: white; border: 1px solid #ddd;")">
                            <div style="font-size: 12px; margin-bottom: 5px; opacity: 0.8;">
                                @GetSenderName(message)
                                • @message.SentAt.ToString("dd.MM.yyyy HH:mm")
                            </div>
                            <div>@message.MessageText</div>
                            
                            @if (message.Files != null && message.Files.Any()) {
                                <div style="margin-top: 10px;">
                                    @foreach (var file in message.Files) {
                                        <button style="color: @(isCurrentUser ? "white" : "#0a53be");
                                            background: none;
                                            border: none;
                                            text-decoration: underline;
                                            cursor: pointer;"
                                                @onclick="() => GetFile(file)">
                                            📎 @file.FileName
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    
    <div class="message-input">
        <textarea @bind="_newMessage"
                  @bind:event="oninput"
                  placeholder="Введите сообщение..."
                      style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; resize: vertical; min-height: 80px; font-family: inherit;">
        </textarea>
        
            <div style="display: flex; gap: 10px; margin-top: 10px; align-items: flex-start;">
                <div class="form-group" style="flex: 1;">
                    <label for="chatFiles" class="form-label" style="font-weight: 500; margin-bottom: 5px;">Файлы</label>
                    <div class="input-group">
                        <InputFile id="chatFiles" multiple OnChange="@OnFileUpload" class="form-control" style="padding: 0.375rem 0.75rem;" />
                        @if (_uploadedFiles.Any()) {
                            <button type="button" class="btn btn-outline-danger" @onclick="ClearFiles" style="white-space: nowrap;">
                                <i class="bi bi-trash"></i> Очистить
                            </button>
                        }
                    </div>
                
                    <small class="form-text text-muted" style="display: block; margin-top: 5px; font-size: 12px;">
                        Максимальный размер файла: 10 МБ.
                        Разрешенные форматы: @string.Join(", ", _allowedFileTypes)
                    </small>
                
                    @if (_uploadedFiles.Any()) {
                        <div class="mt-2">
                            <strong>Выбранные файлы (@_uploadedFiles.Count):</strong>
                            <div class="list-group mt-2" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var file in _uploadedFiles) {
                                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="padding: 8px 12px;">
                                        <span style="word-break: break-all; font-size: 13px;">
                                            <i class="bi bi-file-earmark"></i> @file.Name
                                        </span>
                                        <div>
                                            <span class="badge bg-secondary me-2" style="font-size: 11px;">@(FormatFileSize(file.Size))</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFile(file)" style="padding: 2px 6px;">
                                                <i class="bi bi-x" style="font-size: 14px;"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            
                <button @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_newMessage) && !_uploadedFiles.Any())"
                        style="padding: 8px 20px; background: #006928d8; color: white; border: none; border-radius: 4px; margin-top: 31px; white-space: nowrap; height: fit-content;">
                    Отправить
                </button>
            </div>
        </div>
    </div>