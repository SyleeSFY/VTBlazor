@page "/contacts"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container">
    <div class="Block">
        <TittleUnderStick Tittle="Контакты для связи!"
                          JustifyContent="JustifyContentEnum.Center"
                          FontSize="48" />

        <div class="BlockContacts">
            <div class="LeftBlockContacts">
                <div class="Left">
                    <div class="FirstBlock">
                        <div class="ContactsInfo">
                            <img src="/image/ContactsPage/Geo.png" alt="" class="ContactsIMG" />
                            <p class="ContactsContentTittle">Адрес:</p>
                            <p class="ContactsContent">214013, г. Смоленск, Энергетический проезд, д. 1</p>
                        </div>
                    </div>
                    <div class="SecondBlock">
                        <div class="ContactsInfo">
                            <img src="/image/ContactsPage/Mail.png" alt="" class="ContactsIMG" />
                            <p class="ContactsContentTittle">Почта:</p>
                            <p class="ContactsContent">VT@sbmpei.ru</p>
                        </div>
                    </div>
                </div>
                <div class="Right">
                    <div class="FirstBlock">
                        <div class="ContactsInfo">
                            <img src="/image/ContactsPage/Phone.png" alt="" class="ContactsIMG" />
                            <p class="ContactsContentTittle">Телефон:</p>
                            <p class="ContactsContent">
                                +7(4812) 39-11-60<br />
                                +7(4812) 39-11-68
                            </p>
                        </div>
                    </div>
                    <div class="SecondBlock">
                        <div class="ContactsInfo contact-person">
                            <p class="contact-person-title"><strong>Контактное лицо</strong></p>
                            <p class="ContactsContent contact-person-name">
                                Ольшевская<br />
                                Ирина Николаевна
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="RightBlockContacts">

                    <div class="map-fallback">
                        <img src="/image/ContactsPage/MapFallback.jpg" alt="Карта недоступна" class="map-fallback-img" />
                        <div class="map-fallback-overlay">
                            <p class="map-fallback-address">214013, г. Смоленск, Энергетический проезд, д. 1</p>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>