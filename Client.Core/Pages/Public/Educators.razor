@page "/Educators"
@using Client.Core.Features
@layout MainLayout
@inject HttpClient Http

<div class="container">
    @if (_isLoading)
    {
        <Loading/>
    }
    else {
        <div class="EducatorsCards">
            @foreach (var educator in _educators) {
                <EducatorCard EducatorEntitie="@educator" />
            }
        </div>
    }
</div>